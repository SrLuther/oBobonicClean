[Unit]
Description=ARK: Survival Evolved - Genesis 2
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=5
User=multimax
WorkingDirectory=/opt/obobonicclean
# Ajuste o ExecStart para o comando correto do servidor ARK Genesis 2
ExecStart=/opt/obobonicclean/venv/bin/python /opt/obobonicclean/bot.py --map "Genesis 2"

[Install]
WantedBy=multi-user.target
