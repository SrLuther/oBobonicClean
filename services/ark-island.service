[Unit]
Description=ARK: Survival Evolved - The Island
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=5
User=multimax
WorkingDirectory=/opt/obobonicclean
# Ajuste o ExecStart para o comando correto do servidor ARK The Island
ExecStart=/opt/obobonicclean/venv/bin/python /opt/obobonicclean/bot.py --map "The Island"

[Install]
WantedBy=multi-user.target
